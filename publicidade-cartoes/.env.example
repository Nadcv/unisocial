# Copia para .env (local) ou configura estas variáveis no dashboard da Vercel
# (Project Settings > Environment Variables). NUNCA commites o .env real.

# --- Stripe (dashboard.stripe.com > Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# URL pública do site (para os redirects de sucesso/cancelamento do Checkout)
PUBLIC_SITE_URL=https://o-teu-dominio.vercel.app

# --- Supabase (dashboard.supabase.com > Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key (tem acesso total, só é usada no servidor, nunca no browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Gelato (dashboard.gelato.com > Developers > API keys) ---
GELATO_API_KEY=...
# UID exato de cada produto no catálogo da Gelato. Confirma antes de ir a produção:
# GET https://product.gelatoapis.com/v3/products:search com o teu GELATO_API_KEY,
# filtrando pelo tamanho/acabamento que quiseres vender. Os valores abaixo são só
# placeholders e podem não existir.
GELATO_PRODUCT_UID=cards_pf_bx-w-89-h-51_pt_350-gsm-coated-silk_cl_4-4_ct_none-none_ft_none
# UID do produto "convite impresso" (ex: postal/flyer A5 ou A6) — só é usado para o
# formato "convite" com entrega impressa; "convite-digital" nunca chega à Gelato.
GELATO_PRODUCT_UID_CONVITE=...

# --- Resend (resend.com > API Keys) — opcional, só para o e-mail de entrega do convite
#     digital. Sem isto configurado, a entrega continua a funcionar por download em
#     pedido-confirmado.html, só não é enviado o e-mail. ---
RESEND_API_KEY=
EMAIL_FROM=UniAds Studio <onboarding@resend.dev>

# --- Preço (em cêntimos, moeda = currency abaixo) por produto e escalão de quantidade ---
# Ajusta depois de saberes o custo real da Gelato (impressão + envio) para a tua margem.
# Formato: "formato:quantidade:preco_centimos,formato:quantidade:preco_centimos,..."
# Formatos: "card" (cartão de visita), "convite" (convite impresso, qtd=1 sempre no
# "convite-digital", entregue por download/e-mail, sem envio físico).
PRICE_TABLE=card:100:2999,card:250:4999,card:500:7999,convite:5:1499,convite:10:1999,convite:20:2999,convite:50:4999,convite:100:7999,convite-digital:1:990
CURRENCY=eur
